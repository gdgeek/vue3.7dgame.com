# Local frontend connected to the same backend/plugins as d.xrugc.com.
# Saves affect that online account; this mode does not deploy the local code.
VITE_APP_PORT=3001
VITE_APP_REMOTE_ORIGIN=https://d.xrugc.com
VITE_APP_API_URL=/api
VITE_APP_AUTH_API=/api-auth
VITE_AUTH_PROVIDER=identity
VITE_APP_BLOCKLY_URL=https://blockly.plugins.xrugc.com
VITE_APP_EDITOR_URL=https://editor.plugins.xrugc.com
VITE_APP_WECHAT_AUTH_API=/wechat-auth
VITE_APP_WECHAT_AUTH_PROXY_TARGET=https://auth.bujiaban.com
VITE_APP_BASE_MODE=bujiaban.com
VITE_APP_DOC_API=https://hololens2.cn/wp-json/wp/v2/
VITE_APP_DEV_DOMAIN_FALLBACK=d.xrugc.com
VITE_MOCK_DEV_SERVER=false
