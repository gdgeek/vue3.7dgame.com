# __RESOLVER__

# __LB_HTTP_BLOCK__

# Generated from public/config/domains/*.json at build time. Nginx `hostnames`
# maps select the longest matching domain suffix, so any subdomain resolves to
# the nearest checked-in white-label config and unknown hosts use default.json.
include /usr/share/nginx/html/config/domains/white-label-nginx-map.conf;

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # ============ Gzip 压缩配置 ============
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        text/xml
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        application/vnd.ms-fontobject
        application/x-font-ttf
        font/opentype
        image/svg+xml
        image/x-icon;

    # ============ 反向代理 - 文档 API (WordPress) ============
    location /api-doc/ {
        proxy_pass ${APP_DOC_API_URL}/;

        # HTTPS 上游：启用 SNI
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时配置
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Unity is part of this image. Missing assets never reach the SPA or a plugin.
    location = /webgl-preview/active.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location ^~ /webgl-preview/ {
        gzip off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;

        location ~ \.wasm\.gz$ {
            types { } default_type application/wasm;
            add_header Content-Encoding gzip;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        location ~ \.data\.gz$ {
            types { } default_type application/octet-stream;
            add_header Content-Encoding gzip;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        location ~ \.framework\.js\.gz$ {
            types { } default_type application/javascript;
            add_header Content-Encoding gzip;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        location ~ \.wasm\.br$ {
            types { } default_type application/wasm;
            add_header Content-Encoding br;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        location ~ \.data\.br$ {
            types { } default_type application/octet-stream;
            add_header Content-Encoding br;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        location ~ \.framework\.js\.br$ {
            types { } default_type application/javascript;
            add_header Content-Encoding br;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }
        # SW has no Service-Worker-Allowed override: its maximum scope is its
        # own release directory. HTML/metadata are always revalidated.
        location ~ \.html$ {
            add_header Cache-Control "no-cache, must-revalidate" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header Content-Security-Policy "connect-src 'self' https://data.7dgame.com https://7dgame-public-1251022382.cos.ap-nanjing.myqcloud.com https://mrpp-1257979353.cos.ap-chengdu.myqcloud.com blob:; frame-src 'self' blob:; worker-src 'self' blob:" always;
            try_files $uri =404;
        }
        location ~ (?:/sw\.js|\.json)$ {
            add_header Cache-Control "no-cache, must-revalidate" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            try_files $uri =404;
        }
    }

    location = /__xrugc_proxy__ {
        return 404;
    }

    location ^~ /__xrugc_proxy__/ {
        return 404;
    }

    # ============ 反向代理 - API (由 docker-entrypoint.sh 动态生成) ============
    # __API_LOCATIONS__

    # ============ 反向代理 - 统一认证 API (由 docker-entrypoint.sh 动态生成) ============
    # __AUTH_LOCATIONS__

    # ============ 反向代理 - 配置 API (由 docker-entrypoint.sh 动态生成) ============
    # __CONFIG_LOCATIONS__

    # ============ 自定义 JSON 错误响应 ============
    error_page 502 /502.json;
    location = /502.json {
        internal;
        default_type application/json;
        return 502 '{"error": "Bad Gateway", "status": 502}';
    }

    error_page 503 /503.json;
    location = /503.json {
        internal;
        default_type application/json;
        return 503 '{"error": "Service Unavailable", "status": 503}';
    }

    error_page 504 /504.json;
    location = /504.json {
        internal;
        default_type application/json;
        return 504 '{"error": "Gateway Timeout", "status": 504}';
    }

    # ============ 缓存策略 ============
    # Runtime environment is generated at container startup and must never be
    # cached like hashed build assets.
    location = /__env.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri =404;
    }

    # White-label domain JSON is runtime configuration, not build output.
    location ^~ /config/domains/ {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri =404;
    }

    # Stable Unity/frontend white-label entrypoint. The same frontend image is
    # served by many hosts, so select the JSON by Host and walk toward the
    # parent domain before falling back to default.json.
    location ~ ^/white-label/?$ {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files
            $white_label_config_uri
            /config/domains/default.json
            =404;
    }

    # JS/CSS 文件带 hash，长期缓存
    location ~* \.(?:js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 字体文件长期缓存
    location ~* \.(?:woff2?|eot|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 图片缓存 30 天
    location ~* \.(?:png|jpg|jpeg|gif|webp|svg|ico)$ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # HTML 不缓存（确保用户获取最新版本）
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        # Do not probe $uri/ here. Vite emits real asset directories such as
        # /resource/, and that probe rewrites the SPA parent route /resource
        # to the physical directory before Vue Router can apply its redirect.
        try_files $uri /index.html;
    }

    location = /index.html {
        internal;
    }
}
